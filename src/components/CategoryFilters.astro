---
export interface Props {
  categories: string[];
  categoryColorMap: Record<string, string>;
}

const { categories, categoryColorMap } = Astro.props;
---

<div class="mb-10">
  <h2 class="text-sm font-bold uppercase tracking-wider text-base-content/60 mb-4 ml-1">
    Browse by Category
  </h2>
  <div class="flex flex-wrap gap-3" id="category-filters">
    <button
      class="category-filter btn btn-primary btn-sm rounded-full filter-active"
      data-category="all"
    >
      All Tools
    </button>
    {
      categories.map((category) => {
        return (
          <button
            class="category-filter btn btn-outline btn-sm rounded-full hover:btn-primary border-base-content/10"
            data-category={category}
          >
            {category}
          </button>
        );
      })
    }
  </div>
</div>